{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tabgen-studio",
  "version": "0.1.0",
  "identifier": "dev.tabgen.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tabgen Studio",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Audio to guitar/bass tablature (desktop front end for tabgen)",
    "longDescription": "tabgen Studio runs the tabgen pipeline (stem separation, analysis, transcription, tablature) through the Python worker of an existing tabgen install and exports Guitar Pro, MusicXML, MIDI and ASCII tabs.",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      }
    }
  }
}
